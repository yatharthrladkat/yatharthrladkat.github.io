# =====================================================================
# EL NIÑO DROUGHT INTELLIGENCE & OPTIMIZER - ENVIRONMENT CONFIGURATION
# =====================================================================

# Server Port (Defaults to 3000 locally; in Cloud Run/Render/Railway, this is injected automatically)
PORT=3000

# Node Environment (set to 'production' on live hosts)
NODE_ENV="production"

# GEMINI AI API: Required for AI Cabinet Directives and Grounding
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Public Application URL (where this instance is reachable)
# Example: https://elnino-optimizer.example.com
APP_URL=""

# OPTIONAL: Supabase / Cloud SQL PostgreSQL Database
# If left empty, the engine uses the atomic embedded JSON database in /data/app_database.json with zero setup.
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_KEY=""
